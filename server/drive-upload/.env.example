# Google service account JSON (paste entire JSON as one line, or use path below)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Or path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Shared Drive or folder ID to receive uploads
# GOOGLE_DRIVE_FOLDER_ID=

# Optional: shared secret for simple auth from the widget (set same value in uga-template-manager drive-upload-secret)
# DRIVE_UPLOAD_TOKEN=
