# D2L OAuth 2.0 Configuration
# Get these from D2L Admin Tools > Manage Extensibility > OAuth 2.0
D2L_CLIENT_ID=your_client_id_here
D2L_CLIENT_SECRET=your_client_secret_here

# D2L API Configuration
D2L_API_URL=https://ugatest2.view.usg.edu
D2L_AUTH_URL=https://auth.brightspace.com/oauth2/auth
D2L_TOKEN_URL=https://auth.brightspace.com/core/connect/token

# OAuth Scopes (comma-separated)
D2L_SCOPES=grades:gradevalues:write grades:gradeobjects:read grades:gradeobjects:write

# Server Configuration
PORT=3000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://ugatest2.view.usg.edu,https://your-domain.com
